+  guint32 sum = 0xa5a5;
+  for (guint i = 0; i < 127; i++)
+    sum += goodix_581a_config[i * 2] |
+           (goodix_581a_config[i * 2 + 1] << 8);
+
+  const guint16 checksum = -sum;
+  const guint16 stored_checksum = goodix_581a_config[0xfe] |
+                                  (goodix_581a_config[0xff] << 8);
+  const guint16 tcode = goodix_581a_config[0xeb] |
+                        (goodix_581a_config[0xec] << 8);
+
+  g_assert_cmpuint (tcode, ==, 0x0010);
+  g_assert_cmpuint (stored_checksum, ==, checksum);
+  g_assert_cmpuint (stored_checksum, ==, 0x64a2);
+}
+
+static void
+test_frame_average (void)
+{
+  g_autofree guint32 *sum = g_new0 (guint32, GOODIX_581A_FRAME_SIZE);
+  g_autofree GoodixTls5xxPix *frame =
+    g_new (GoodixTls5xxPix, GOODIX_581A_FRAME_SIZE);
+  g_autofree GoodixTls5xxPix *average =
+    g_new (GoodixTls5xxPix, GOODIX_581A_FRAME_SIZE);
+
+  for (guint frame_index = 1; frame_index <= GOODIX_581A_AVERAGE_FRAMES;
+       frame_index++)
+    {
+      for (guint i = 0; i < GOODIX_581A_FRAME_SIZE; i++)
+        frame[i] = frame_index * 10;
+      goodix_581a_accumulate_frame (sum, frame);
+    }
+
+  goodix_581a_finish_average (average, sum, GOODIX_581A_AVERAGE_FRAMES);
+  g_assert_cmpuint (average[0], ==, 25);
+  g_assert_cmpuint (average[GOODIX_581A_FRAME_SIZE / 2], ==, 25);
+  g_assert_cmpuint (average[GOODIX_581A_FRAME_SIZE - 1], ==, 25);
+}
+
 int
