From 3914d0f4bb05aa7b60adb74015e8f215ef36590b Mon Sep 17 00:00:00 2001
From: Space-Dev0 <179112172+Space-Dev0@users.noreply.github.com>
Date: Wed, 11 Nov 2026 15:51:02 +0530
Subject: [PATCH 19/19] goodix581a: cancel a superseded scan state machine

---
 libfprint/drivers/goodixtls/goodix581a.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/libfprint/drivers/goodixtls/goodix581a.c b/libfprint/drivers/goodixtls/goodix581a.c
index e8c7339..cb27a99 100644
--- a/libfprint/drivers/goodixtls/goodix581a.c
+++ b/libfprint/drivers/goodixtls/goodix581a.c
@@ -565,6 +565,17 @@ dev_581a_change_state (FpImageDevice *img_dev, FpiImageDeviceState state)
   if (state == FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_ON)
     {
       fp_dbg ("581a entering AWAIT_FINGER_ON state");
+
+      if (self->scan_ssm)
+        {
+          FpiSsm *previous = self->scan_ssm;
+          self->scan_ssm = NULL;
+          fp_warn ("581a: superseding an existing scan state machine");
+          fpi_ssm_mark_failed (previous,
+                               g_error_new (G_IO_ERROR, G_IO_ERROR_CANCELLED,
+                                            "Superseded by a new scan"));
+        }
+
       self->scan_ssm = fpi_ssm_new (dev, scan_581a_run_state, SCAN_581A_NUM_STATES);
       fpi_ssm_start (self->scan_ssm, scan_581a_complete);
     }
