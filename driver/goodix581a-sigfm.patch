+/* Return TRUE if the collected TLS records contain a handshake message of
+ * @type.  Handshake messages may be packed together in one record or split
+ * across records, so parse the concatenated handshake payload instead of
+ * assuming one message per record.
+ */
+static gboolean
+tls_records_contain_handshake_type (const guint8 *data, int total, guint8 type)
+{
+  g_autoptr(GByteArray) handshake = g_byte_array_new ();
+  gboolean found = FALSE;
+  int offset = 0;
+
+  while (offset + 5 <= total)
+    {
+      const guint8 *record = data + offset;
+      guint16 record_len = (record[3] << 8) | record[4];
+
+      if (offset + 5 + record_len > total)
+        break;
+
+      if (record[0] == 0x16)
+        g_byte_array_append (handshake, record + 5, record_len);
+
+      offset += 5 + record_len;
+    }
+
+  gsize pos = 0;
+  while (pos + 4 <= handshake->len)
+    {
+      guint8 msg_type = handshake->data[pos];
+      guint32 msg_len = ((guint32) handshake->data[pos + 1] << 16) |
+                        ((guint32) handshake->data[pos + 2] << 8) |
+                        handshake->data[pos + 3];
+
+      if (msg_type == type)
+        {
+          found = TRUE;
+          break;
+        }
+
+      if (msg_len > handshake->len - pos - 4)
+        break;
+
+      pos += 4 + msg_len;
+    }
+
+  return found;
